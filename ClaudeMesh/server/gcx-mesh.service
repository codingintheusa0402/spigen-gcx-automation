[Unit]
Description=GCX Mesh (server) - iPhone access to this machine's Claude Code sessions
After=network-online.target

[Service]
ExecStart=/usr/bin/node __ROOT__/server/mesh-server.js
Restart=always
RestartSec=5
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=%h

[Install]
WantedBy=default.target
